<Window x:Class="WinSecAuditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSec Auditor - Security Posture Platform" Height="750" Width="1200"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource FontUI}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════
             FINDING CARD TEMPLATE (reused în Dashboard + History)
             ═══════════════════════════════════════════════ -->
        <DataTemplate x:Key="FindingCardTemplate">
            <Border Background="{StaticResource BgSecondary}" 
                    BorderBrush="{StaticResource BorderSubtle}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Severity color strip -->
                    <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource SevInfo}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                        <Setter Property="Fill" Value="{StaticResource SevCritical}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="High">
                                        <Setter Property="Fill" Value="{StaticResource SevHigh}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                        <Setter Property="Fill" Value="{StaticResource SevMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Low">
                                        <Setter Property="Fill" Value="{StaticResource SevLow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <Grid Grid.Column="1" Margin="18,14,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: title + status chip + severity chip -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TextH2}" VerticalAlignment="Center"/>

                            <!-- Status chip -->
                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource StatusFailBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource StatusPassBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="FAIL"/>
                                            <Setter Property="Foreground" Value="{StaticResource StatusFail}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                    <Setter Property="Text" Value="PASS"/>
                                                    <Setter Property="Foreground" Value="{StaticResource StatusPass}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Severity chip -->
                            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SevInfoBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                <Setter Property="Background" Value="{StaticResource SevCriticalBg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                                <Setter Property="Background" Value="{StaticResource SevHighBg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                <Setter Property="Background" Value="{StaticResource SevMediumBg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                <Setter Property="Background" Value="{StaticResource SevLowBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SevInfo}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="Foreground" Value="{StaticResource SevCritical}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                    <Setter Property="Foreground" Value="{StaticResource SevHigh}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                    <Setter Property="Foreground" Value="{StaticResource SevMedium}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                    <Setter Property="Foreground" Value="{StaticResource SevLow}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Description -->
                        <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource TextBody}" Margin="0,0,0,8"/>

                        <!-- Evidence + ID footer -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Evidence}" Style="{StaticResource TextMono}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Id}" Style="{StaticResource TextMono}" Margin="12,0,0,0" Foreground="{StaticResource TextTertiary}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════
             SIDEBAR
             ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,32">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentPrimary}" Margin="0,0,10,0"/>
                        <TextBlock Text="WinSec" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Auditor" FontSize="18" FontWeight="Light" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Security Posture Platform" Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MONITORING" Style="{StaticResource TextCaption}" Margin="20,0,0,8"/>

                    <Button x:Name="BtnNavDashboard" Style="{StaticResource SidebarNavButton}" Click="BtnNavDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavWindowsSec" Style="{StaticResource SidebarNavButton}" Click="BtnNavWindowsSec_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE730;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Windows Security" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavNetwork" Style="{StaticResource SidebarNavButton}" Click="BtnNavNetwork_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Network &amp; Firewall" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavStartup" Style="{StaticResource SidebarNavButton}" Click="BtnNavStartup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Startup &amp; Processes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ACTIONS" Style="{StaticResource TextCaption}" Margin="20,24,0,8"/>

                    <Button x:Name="BtnNavHardening" Style="{StaticResource SidebarNavButton}" Click="BtnNavHardening_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Hardening Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavHistory" Style="{StaticResource SidebarNavButton}" Click="BtnNavHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Scan History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExport" Style="{StaticResource SidebarNavButton}" Click="BtnExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Export Report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: privilege status + version -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PrivilegeDot" Width="8" Height="8" Fill="{StaticResource StatusPass}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtPrivilege" Text="Administrator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Text="v1.0.0 · SQLite backed" Style="{StaticResource TextMono}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             DASHBOARD VIEW
             ═══════════════════════════════════════════════ -->
        <Grid x:Name="ViewDashboard" Grid.Column="1" Margin="32,28,32,20" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCategoryTitle" Text="Security Overview" Style="{StaticResource TextH1}"/>
                    <TextBlock x:Name="TxtLastScanCaption" Text="Rulează un audit pentru a începe" Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnRunAudit" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRunAudit_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="RUN FULL AUDIT" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Metrics Row: Score Card + KPI Tiles -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SCORE CARD -->
                <Border Grid.Column="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="24,20" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SECURITY SCORE" Style="{StaticResource TextCaption}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtScore" Text="--" Style="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                            <TextBlock Text="/100" FontSize="20" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,16"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStatus" Text="Awaiting Scan" Style="{StaticResource TextH2}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <!-- Progress bar -->
                        <Grid x:Name="ScoreFillBarBg" Height="6" Background="{StaticResource BgElevated}">
                            <Rectangle x:Name="ScoreFillBar" HorizontalAlignment="Left" Fill="{StaticResource TextTertiary}" Width="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- KPI TILES -->
                <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                    <!-- Critical -->
                    <Border Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{StaticResource SevCriticalBg}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SevCritical}"/>
                                </Border>
                                <TextBlock Text="CRITICAL" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtKpiCritical" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Failures" Style="{StaticResource TextBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- High -->
                    <Border Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{StaticResource SevHighBg}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SevHigh}"/>
                                </Border>
                                <TextBlock Text="HIGH" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtKpiHigh" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Failures" Style="{StaticResource TextBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- Medium -->
                    <Border Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{StaticResource SevMediumBg}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SevMedium}"/>
                                </Border>
                                <TextBlock Text="MEDIUM" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtKpiMedium" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Failures" Style="{StaticResource TextBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- Passed -->
                    <Border Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{StaticResource StatusPassBg}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource StatusPass}"/>
                                </Border>
                                <TextBlock Text="PASSED" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtKpiPassed" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Controls" Style="{StaticResource TextBody}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Findings list -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SECURITY FINDINGS" Style="{StaticResource TextCaption}" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListFindings" ItemTemplate="{StaticResource FindingCardTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             HARDENING CENTER VIEW
             ═══════════════════════════════════════════════ -->
        <Grid x:Name="ViewHardening" Grid.Column="1" Margin="32,28,32,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Hardening Center" Style="{StaticResource TextH1}"/>
                <TextBlock Text="Aplică remedieri automatizate pentru findings-urile detectate ca insecure." Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListRemediations">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0" Fill="{StaticResource DangerPrimary}" RadiusX="2" RadiusY="2"/>

                                        <StackPanel Grid.Column="1" Margin="20,16,20,16">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource DangerPrimary}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextH2}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Recommendation}" Style="{StaticResource TextBody}"/>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource TextMono}" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource DangerButton}" Margin="0,0,20,0" VerticalAlignment="Center"
                                                Tag="{Binding Id}" Click="BtnApplyFix_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBlock Text="APPLY FIX" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="PnlHardeningEmpty" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="56" Foreground="{StaticResource StatusPass}" Margin="0,0,0,16"/>
                    <TextBlock Text="Sistem securizat" Style="{StaticResource TextH2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nu există findings care necesită remediere automatizată."
                               Style="{StaticResource TextBody}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             SCAN HISTORY VIEW
             ═══════════════════════════════════════════════ -->
        <Grid x:Name="ViewHistory" Grid.Column="1" Margin="32,28,32,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Scan History" Style="{StaticResource TextH1}"/>
                <TextBlock Text="Evoluția posturii de securitate în timp — persistată local prin SQLite." Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Trend Card -->
            <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="24,20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentPrimary}" Margin="0,0,8,0"/>
                        <TextBlock Text="SCORE TREND — LAST 15 SCANS" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Canvas x:Name="SparklineCanvas" Height="110" Background="Transparent" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListScanHistory">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,14" Cursor="Hand"
                                            Background="Transparent" MouseLeftButtonDown="ScanHistoryItem_Click" Tag="{Binding Id}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BgHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ScanDate, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource TextBody}" Margin="0,4,0,0" FontSize="11">
                                                    <Run Text="{Binding Status}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding FailedFindings}"/>
                                                    <Run Text=" failed"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource StatusFailBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Secure">
                                                                <Setter Property="Background" Value="{StaticResource StatusPassBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Attention Required">
                                                                <Setter Property="Background" Value="{StaticResource SevHighBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Score}" FontSize="16" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusFail}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Secure">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusPass}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Attention Required">
                                                                    <Setter Property="Foreground" Value="{StaticResource SevHigh}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListHistoricalFindings" ItemTemplate="{StaticResource FindingCardTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtHistoryPlaceholder" 
                               Text="Selectează un scan din lista din stânga pentru a vedea detaliile."
                               Style="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" TextAlignment="Center"/>
                </Grid>
            </Grid>

