<Application x:Class="WinSecAuditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinSecAuditor"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════════
             DESIGN TOKENS — COLORS
             ═══════════════════════════════════════════════ -->

        <!-- Backgrounds -->
        <SolidColorBrush x:Key="BgPrimary"   Color="#0A0C10"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#12151B"/>
        <SolidColorBrush x:Key="BgTertiary"  Color="#181C25"/>
        <SolidColorBrush x:Key="BgElevated"  Color="#1F242F"/>
        <SolidColorBrush x:Key="BgHover"     Color="#232833"/>

        <!-- Borders -->
        <SolidColorBrush x:Key="BorderSubtle" Color="#1F242E"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#2D3340"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimary"   Color="#E8EAED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA4B8"/>
        <SolidColorBrush x:Key="TextTertiary"  Color="#5A6478"/>

        <!-- Accent (primary actions) -->
        <SolidColorBrush x:Key="AccentPrimary"      Color="#4F8FFF"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#6BA0FF"/>

        <!-- Severity -->
        <SolidColorBrush x:Key="SevCritical"   Color="#FF4757"/>
        <SolidColorBrush x:Key="SevCriticalBg" Color="#2A1518"/>
        <SolidColorBrush x:Key="SevHigh"       Color="#FF9F43"/>
        <SolidColorBrush x:Key="SevHighBg"     Color="#2A1F14"/>
        <SolidColorBrush x:Key="SevMedium"     Color="#FECA57"/>
        <SolidColorBrush x:Key="SevMediumBg"   Color="#2A2515"/>
        <SolidColorBrush x:Key="SevLow"        Color="#48DBFB"/>
        <SolidColorBrush x:Key="SevLowBg"      Color="#142428"/>
        <SolidColorBrush x:Key="SevInfo"       Color="#A4B0BE"/>
        <SolidColorBrush x:Key="SevInfoBg"     Color="#1F232B"/>

        <!-- Status (Pass/Fail) -->
        <SolidColorBrush x:Key="StatusPass"   Color="#26DE81"/>
        <SolidColorBrush x:Key="StatusPassBg" Color="#0F2A1B"/>
        <SolidColorBrush x:Key="StatusFail"   Color="#FF4757"/>
        <SolidColorBrush x:Key="StatusFailBg" Color="#2A1518"/>

        <!-- Danger (Apply Fix, Delete) -->
        <SolidColorBrush x:Key="DangerPrimary"      Color="#DC3545"/>
        <SolidColorBrush x:Key="DangerPrimaryHover" Color="#E85566"/>

        <!-- ═══════════════════════════════════════════════
             FONT FAMILIES
             ═══════════════════════════════════════════════ -->
        <FontFamily x:Key="FontUI">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="FontIcon">Segoe MDL2 Assets</FontFamily>

        <!-- ═══════════════════════════════════════════════
             TEXTBLOCK STYLES
             ═══════════════════════════════════════════════ -->
        <Style x:Key="TextDisplay" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="72"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="TextH1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="TextH2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="TextBody" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TextCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        </Style>
        <Style x:Key="TextMono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════
             ICON STYLE (Segoe MDL2 Assets)
             ═══════════════════════════════════════════════ -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════════════════════
             BUTTONS
             ═══════════════════════════════════════════════ -->

        <!-- SIDEBAR NAV BUTTON -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="ActiveBar" Grid.Column="0" Fill="Transparent"/>
                            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentPrimary}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON (Apply Fix) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource DangerPrimary}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             SCROLLBAR (dark theme, slim)
             ═══════════════════════════════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="Width" Value="8"/>
        </Style>

    </Application.Resources>
</Application>